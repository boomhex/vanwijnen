# Copy this file to .env in this same folder and fill in the real values.
# .env is gitignored (see /.gitignore) - never commit the real one.

# Required. Gemini API key used for offer extraction and comparison matching.
GEMINI_API_KEY=

# Optional. HTTP port the app listens on. Defaults to 8080 if unset.
# PORT=8080

# Optional. Signs session cookies. If unset, main.py auto-generates and
# persists one to .storage_secret on first run - usually no need to set this.
# STORAGE_SECRET=
